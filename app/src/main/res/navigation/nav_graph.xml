<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/firstFragment">

    <fragment
        android:id="@+id/firstFragment"
        android:name="com.hfad.htmlactivity.FirstFragment"
        android:label="fragment_first"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_firstFragment_to_htmlDisplayFragment"
            app:destination="@id/htmlDisplayFragment" />
    </fragment>

    <fragment
        android:id="@+id/htmlDisplayFragment"
        android:name="com.hfad.htmlactivity.HtmlDisplayFragment"
        android:label="fragment_html_display"
        tools:layout="@layout/fragment_html_display">

        <argument
            android:name="htmlContent"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

</navigation>
